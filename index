<style>
:root{--charcoal:#211E1D;--white:#FFFDFB;--cream:#F6F2ED;--sand:#E9DFD5;--taupe:#967563;--grey:#756E6A;--wa:#1FA84F}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--white);color:var(--charcoal);font-size:15px;line-height:1.6}
h1,h2,h3,.serif{font-family:'Cormorant Garamond',serif;font-weight:500}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--taupe);outline-offset:2px}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.topbar{background:var(--charcoal);color:var(--sand);font-size:12px;text-align:center;padding:7px 12px}
header{position:sticky;top:0;background:var(--white);border-bottom:1px solid var(--sand);z-index:20}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px;gap:20px}
.logo{font-family:'Cormorant Garamond',serif;font-size:26px;letter-spacing:.18em;line-height:1}
.logo small{display:block;font-family:'DM Sans';font-size:7px;letter-spacing:.35em;text-align:center;margin-top:3px}
nav ul{display:flex;gap:26px;list-style:none;font-size:13.5px}
nav a{padding:6px 0;border-bottom:1px solid transparent;transition:border-color .2s}
nav a:hover,nav a.on{border-color:var(--charcoal)}
.icons{display:flex;gap:16px;align-items:center}
.icons button{background:none;border:0;font-size:18px;position:relative}
.badge{position:absolute;top:-6px;right:-9px;background:var(--charcoal);color:#fff;border-radius:50%;width:16px;height:16px;font-size:10px;display:grid;place-items:center}
.menu-btn{display:none}
.page{display:none}.page.on{display:block}
.btn{display:inline-block;padding:12px 26px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--charcoal);transition:.2s}
.btn.primary{background:var(--charcoal);color:#fff}.btn.primary:hover{background:var(--taupe);border-color:var(--taupe)}
.btn.secondary{background:transparent}.btn.secondary:hover{background:var(--charcoal);color:#fff}
.btn.wa{background:var(--wa);border-color:var(--wa);color:#fff;text-transform:none;letter-spacing:.02em;font-size:13px}
.btn.block{display:block;width:100%;text-align:center}
.sec-title{text-align:center;letter-spacing:.22em;font-size:22px;text-transform:uppercase;margin:60px 0 6px}
.sec-sub{text-align:center;color:var(--grey);margin-bottom:28px;font-size:14px}
/* image placeholders - replace background with url(...) of your photos */
.img{background:linear-gradient(145deg,var(--sand),#d8c6b6);position:relative;overflow:hidden;display:grid;place-items:center;color:var(--taupe)}
.img svg{width:46%;max-width:150px;opacity:.9}
.img.dark{background:linear-gradient(145deg,#4a423e,#1d1a19);color:#cdb9a6}
.img.warm{background:linear-gradient(145deg,#b99276,#7c5a47);color:#f3e4d6}
/* hero */
.hero{background:linear-gradient(100deg,var(--cream) 0%,var(--cream) 42%,transparent 70%),linear-gradient(145deg,#d9c3b0,#8b6a58);min-height:480px;display:flex;align-items:center}
.hero h1{font-size:clamp(40px,6vw,66px);line-height:1.05;margin-bottom:18px;max-width:520px}
.hero p{max-width:380px;color:var(--grey);margin-bottom:28px}
.hero .btn+.btn{margin-left:12px}
.trust{display:flex;justify-content:space-around;flex-wrap:wrap;gap:14px;padding:16px 24px;background:var(--cream);font-size:13px;color:var(--grey)}
/* collections */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.coll{height:230px;padding:22px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff}
.coll h3{font-size:30px;letter-spacing:.06em}
.coll p{font-size:12px;opacity:.9}.coll span{font-size:11px;letter-spacing:.12em;margin-top:8px;text-transform:uppercase}
.coll .tint{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.55),transparent 60%)}
.coll>*:not(.tint){position:relative}
/* product cards */
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.card{background:#fff;border:1px solid var(--sand);padding:12px;display:flex;flex-direction:column;cursor:pointer;transition:box-shadow .2s}
.card:hover{box-shadow:0 8px 24px rgba(33,30,29,.08)}
.card .img{aspect-ratio:1/1;margin-bottom:12px}
.tags{position:absolute;top:8px;left:8px;right:8px;display:flex;justify-content:space-between;z-index:2}
.tag{font-size:9px;padding:2px 7px;letter-spacing:.06em;text-transform:uppercase;background:#fff;border:1px solid var(--sand);color:var(--charcoal)}
.tag.women{background:#b5654a;color:#fff;border:0}.tag.men{background:var(--charcoal);color:#fff;border:0}.tag.unisex{background:var(--grey);color:#fff;border:0}
.tag.ok{color:#2c7a4b;border-color:#bfe0cc}
.card h4{font-weight:500;font-size:14px;text-align:center}
.card .price{text-align:center;margin:2px 0 10px;font-weight:500}
.card .btn{padding:9px;font-size:11px}
/* why */
.why{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--sand);background:var(--cream)}
.why div{padding:26px 14px;text-align:center;border-right:1px solid var(--sand);font-size:13px;color:var(--grey)}
.why div:last-child{border:0}.why b{display:block;color:var(--charcoal);margin:8px 0 2px;font-size:14px}.why i{font-style:normal;font-size:26px}
/* banners */
.banner{margin-top:50px;padding:56px 7%;background:linear-gradient(90deg,var(--sand) 50%,#d9c8b8);display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.banner h2{font-size:clamp(28px,4vw,40px);margin:8px 0 12px}.banner p{color:var(--grey);max-width:440px;margin-bottom:20px}
.banner small{letter-spacing:.14em;text-transform:uppercase;font-size:11px}
.box{width:220px;height:130px;background:var(--cream);box-shadow:0 14px 30px rgba(0,0,0,.12);display:grid;place-items:center;font-family:'Cormorant Garamond';letter-spacing:.2em;transform:rotate(-8deg)}
.edit{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.edit .img{aspect-ratio:3/2}
.gift{background:var(--sand);display:flex;justify-content:space-between;align-items:center;gap:20px;padding:44px 7%;flex-wrap:wrap}
.gift h2{font-size:30px;max-width:420px;margin:8px 0 18px}
/* reviews */
