const WA="910000000000";
const P=[
 {id:1,n:"Pearl Heart Chain",g:"Women",c:"Necklace",p:799,t:"Anti-Tarnish",s:'<circle cx="50" cy="40" r="22" fill="none" stroke="currentColor" stroke-width="2"/><path d="M50 62v6" stroke="currentColor" stroke-width="2"/><path d="M50 82c-9-7-12-12-12-16a6 6 0 0112-2 6 6 0 0112 2c0 4-3 9-12 16z" fill="currentColor"/>'},
 {id:2,n:"Classic Curb Chain",g:"Men",c:"Necklace",p:999,t:"",s:'<path d="M15 25c10 55 60 55 70 0" fill="none" stroke="currentColor" stroke-width="7" stroke-dasharray="9 4"/>',d:1},
 {id:3,n:"Minimal Signet Ring",g:"Unisex",c:"Ring",p:899,t:"Bestseller",s:'<ellipse cx="50" cy="55" rx="26" ry="28" fill="none" stroke="currentColor" stroke-width="8"/><rect x="36" y="22" width="28" height="14" rx="3" fill="currentColor"/>'},
 {id:4,n:"Tennis Bracelet",g:"Women",c:"Bracelet",p:1299,t:"Water Resistant",s:'<ellipse cx="50" cy="50" rx="34" ry="22" fill="none" stroke="currentColor" stroke-width="6" stroke-dasharray="2 5" stroke-linecap="round"/>',w:1},
 {id:5,n:"Pearl Studs",g:"Women",c:"Earrings",p:699,t:"",s:'<circle cx="32" cy="50" r="13" fill="currentColor"/><circle cx="68" cy="50" r="13" fill="currentColor"/>'},
 {id:6,n:"Cuban Chain",g:"Men",c:"Necklace",p:999,t:"",s:'<path d="M15 25c10 55 60 55 70 0" fill="none" stroke="currentColor" stroke-width="7" stroke-dasharray="9 4"/>',d:1},
 {id:7,n:"Minimal Ring",g:"Unisex",c:"Ring",p:899,t:"",s:'<ellipse cx="50" cy="55" rx="26" ry="26" fill="none" stroke="currentColor" stroke-width="7"/>'},
 {id:8,n:"Gold Hoops",g:"Women",c:"Earrings",p:749,t:"Anti-Tarnish",s:'<circle cx="32" cy="50" r="18" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="68" cy="50" r="18" fill="none" stroke="currentColor" stroke-width="5"/>'}
];
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const inr=n=>"₹"+n.toLocaleString("en-IN");
let cart=0,cur=P[0],gender="All";
function card(p,full){
 const cls=p.d?"dark":p.w?"warm":"";
 return `<article class="card" data-id="${p.id}"><div class="img ${cls}"><div class="tags"><span class="tag ${p.g.toLowerCase()}">${p.g}</span>${p.t?`<span class="tag ${p.t==="Bestseller"?"":"ok"}">${p.t}</span>`:""}</div><svg viewBox="0 0 100 100" aria-hidden="true">${p.s}</svg></div><h4>${p.n}</h4><div class="price">${inr(p.p)}</div><button class="btn primary add" data-id="${p.id}">Add to cart</button></article>`;
}
function renderBest(){$("#best").innerHTML=P.slice(0,4).map(card).join("")}
function renderShop(){
 const cat=$("#fCat").value,pr=+$("#fPrice").value||99999;
 const list=P.filter(p=>(gender==="All"||p.g===gender)&&(!cat||p.c===cat)&&p.p<=pr);
 $("#shopGrid").innerHTML=list.length?list.map(card).join(""):'<p style="grid-column:1/-1;text-align:center;color:var(--grey)">No pieces match these filters. Try clearing one.</p>';
}
function go(id,g){
 $$(".page").forEach(p=>p.classList.toggle("on",p.id===id));
 $$("nav a").forEach(a=>a.classList.toggle("on",a.dataset.go===id&&!a.dataset.g));
 if(id==="shop"){gender=g||"All";$$("#gender .pill").forEach(b=>b.classList.toggle("on",b.textContent===gender));renderShop()}
 $("#nav").classList.remove("open");window.scrollTo({top:0});
}
function openProduct(id){
 cur=P.find(p=>p.id==id);
 $("#pName").textContent=$("#pCrumb").textContent=cur.n;$("#pPrice").textContent=inr(cur.p);
 const t=$("#pTag");t.textContent=cur.g;t.className="tag "+cur.g.toLowerCase();
 $("#pImg").innerHTML=`<svg viewBox="0 0 100 100" style="width:45%;max-width:260px">${cur.s}</svg>`;
 $("#pImg").className="img"+(cur.d?" dark":cur.w?" warm":"");
 $("#qn").textContent=1;
 $("#pWa").href=`https://wa.me/${WA}?text=${encodeURIComponent("Hi PEARLHUSH, I'd like to order: "+cur.n+" ("+inr(cur.p)+")")}`;
 go("product");
}
function toast(m){const t=$("#toast");t.textContent=m;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),1800)}
function add(n){cart+=n;$("#cartN").textContent=cart;toast("Added to cart")}
document.addEventListener("click",e=>{
 const g=e.target.closest("[data-go]");
 if(g){e.preventDefault();go(g.dataset.go,g.dataset.g);return}
 const a=e.target.closest(".add");
 if(a){e.stopPropagation();add(1);return}
 const c=e.target.closest(".card");
 if(c)openProduct(c.dataset.id);
});
$("#gender").addEventListener("click",e=>{if(e.target.classList.contains("pill")){gender=e.target.textContent;$$("#gender .pill").forEach(b=>b.classList.toggle("on",b===e.target));renderShop()}});
$("#fCat").onchange=$("#fPrice").onchange=renderShop;
$("#menuBtn").onclick=()=>$("#nav").classList.toggle("open");
$("#qm").onclick=()=>{const q=$("#qn");q.textContent=Math.max(1,+q.textContent-1)};
$("#qp").onclick=()=>{const q=$("#qn");q.textContent=+q.textContent+1};
$("#addP").onclick=()=>add(+$("#qn").textContent);
$("#buyNow").onclick=e=>{e.preventDefault();add(+$("#qn").textContent)};
$("#nl").onsubmit=e=>{e.preventDefault();toast("Thanks for joining PEARLHUSH!");e.target.reset()};
renderBest();
</script>
</body>
</html>
