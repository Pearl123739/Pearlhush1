footer{padding:44px 0 20px}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px}
footer h5{font-size:13px;letter-spacing:.08em;margin-bottom:10px}footer li{list-style:none;font-size:13px;color:var(--grey);margin-bottom:4px}
footer li a:hover{color:var(--charcoal)}
.copy{text-align:center;font-size:12px;color:var(--grey);margin-top:26px}
/* shop */
