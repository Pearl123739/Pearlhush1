.stars{color:var(--taupe);letter-spacing:3px;margin-bottom:8px}.rev p{font-style:italic;color:var(--grey);margin-bottom:10px}
.seen{display:grid;grid-template-columns:240px repeat(5,1fr);gap:10px;align-items:center;margin-top:50px}.seen .img{aspect-ratio:1/1.1}
.seen h3{font-size:24px;letter-spacing:.14em;margin-bottom:6px}
/* newsletter + footer */
