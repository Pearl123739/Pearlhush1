.filters select{padding:7px 12px;border:1px solid var(--sand);background:#fff;font-family:inherit;font-size:13px}
/* product */
.crumbs{font-size:12px;color:var(--grey);margin:22px 0}
.pdp{display:grid;grid-template-columns:70px 1fr 1fr;gap:26px;margin-bottom:40px}
.thumbs{display:flex;flex-direction:column;gap:10px}.thumbs .img{aspect-ratio:1/1;border:1px solid var(--sand)}
.pdp>.img{aspect-ratio:1/1.1}
.pdp h1{font-size:34px;margin:8px 0}.pdp .p{font-size:24px}.pdp .p s{color:var(--grey);font-size:15px;margin:0 8px}.pdp .p em{font-style:normal;font-size:12px;color:#2c7a4b}
.ticks{list-style:none;margin:14px 0 18px;font-size:13.5px}.ticks li:before{content:"✓ ";color:#2c7a4b}
.buy{display:grid;grid-template-columns:110px 1fr;gap:10px;margin-bottom:10px}
.qty{display:flex;border:1px solid var(--charcoal);justify-content:space-between;align-items:center;padding:0 12px}.qty button{border:0;background:none;font-size:18px}
details{border-top:1px solid var(--sand);padding:12px 0;font-size:14px}details:last-of-type{border-bottom:1px solid var(--sand)}
summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between}summary:after{content:"⌄"}
details p{color:var(--grey);margin-top:8px}
/* about / care */
.about{display:grid;grid-template-columns:1.2fr 1fr;background:var(--cream);border:1px solid var(--sand);margin:30px 0}
.about>div:first-child{padding:44px}.about h1{font-size:38px;margin-bottom:12px}.about p{color:var(--grey);margin-bottom:12px}
.about .img{min-height:320px}
.vals{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:26px}.vals b{display:block}.vals span{font-size:13px;color:var(--grey)}
.care{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0 40px}
.care>div{background:var(--cream);border:1px solid var(--sand);padding:26px}.care h3{letter-spacing:.14em;margin-bottom:10px}
.care li{list-style:none;font-size:14px;padding:4px 0}.do li:before{content:"✓  ";color:#2c7a4b}.dont li:before{content:"✕  ";color:#b5654a}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--charcoal);color:#fff;padding:11px 22px;font-size:13px;transition:transform .3s;z-index:50}.toast.show{transform:translateX(-50%)}
@media(max-width:900px){
 nav{display:none;position:absolute;top:68px;left:0;right:0;background:var(--white);border-bottom:1px solid var(--sand);padding:14px 24px}nav.open{display:block}nav ul{flex-direction:column;gap:10px}
 .menu-btn{display:block}.grid4,.edit{grid-template-columns:repeat(2,1fr)}.grid3{grid-template-columns:1fr}.why{grid-template-columns:repeat(2,1fr)}
