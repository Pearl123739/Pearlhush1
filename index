 .pdp{grid-template-columns:1fr}.thumbs{flex-direction:row;order:2}.thumbs .img{width:64px}.about,.care{grid-template-columns:1fr}.vals{grid-template-columns:1fr}
 .hero{background:linear-gradient(180deg,var(--cream) 55%,#c9ae9a)}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
